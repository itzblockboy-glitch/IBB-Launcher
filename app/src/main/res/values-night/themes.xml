<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- IBB Launcher is dark-mode-first: night and day map to the same brand surface. -->
    <style name="Theme.Ibb" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/ibb_splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
