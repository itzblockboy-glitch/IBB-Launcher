<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Accounts, tokens and the game directory must never leave the device silently. -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ibb_accounts_secure.xml" />
    </device-transfer>
</data-extraction-rules>
