<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Window-level theme: the real UI is Compose, this only paints before first frame. -->
    <style name="Theme.Ibb" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ibb_splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>

    <!-- Android 12+ splash screen. The avatar sits on the deep-void background. -->
    <style name="Theme.Ibb.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ibb_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ibb_indigo</item>
        <item name="postSplashScreenTheme">@style/Theme.Ibb</item>
    </style>

    <!-- Fullscreen game host: no system bars, GL surface owns every pixel. -->
    <style name="Theme.Ibb.Game" parent="Theme.Ibb">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
